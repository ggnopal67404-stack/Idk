local function MakeSlider(parent,y,title,min,max,getValue,setValue)
	local box=Instance.new("Frame")
	box.Size=UDim2.new(1,0,0,72)
	box.Position=UDim2.fromOffset(0,y)
	box.BackgroundTransparency=1
	box.Parent=parent

	local label=Instance.new("TextLabel")
	label.Size=UDim2.new(1,-70,0,22)
	label.BackgroundTransparency=1
	label.Text=title
	label.TextColor3=Color3.new(1,1,1)
	label.Font=Enum.Font.GothamBold
	label.TextSize=12
	label.TextXAlignment=Enum.TextXAlignment.Left
	label.Parent=box

	local input=Instance.new("TextBox")
	input.Size=UDim2.fromOffset(62,28)
	input.Position=UDim2.new(1,-62,0,-3)
	input.BackgroundColor3=Color3.fromRGB(28,28,32)
	input.TextColor3=Color3.new(1,1,1)
	input.Font=Enum.Font.GothamBold
	input.TextSize=12
	input.ClearTextOnFocus=false
	input.Text=tostring(getValue())
	input.Parent=box
	Corner(input,7)
	Stroke(input,.8,1)

	local track=Instance.new("Frame")
	track.Size=UDim2.new(1,-8,0,8)
	track.Position=UDim2.fromOffset(4,43)
	track.BackgroundColor3=Color3.fromRGB(55,55,60)
	track.BorderSizePixel=0
	track.Active=true
	track.Parent=box
	Corner(track,8)

	local fill=Instance.new("Frame")
	fill.Size=UDim2.fromScale(0,1)
	fill.BackgroundColor3=Color3.fromRGB(60,255,120)
	fill.BorderSizePixel=0
	fill.Parent=track
	Corner(fill,8)

	local knob=Instance.new("TextButton")
	knob.Size=UDim2.fromOffset(18,18)
	knob.AnchorPoint=Vector2.new(.5,.5)
	knob.Position=UDim2.fromScale(0,.5)
	knob.BackgroundColor3=Color3.new(1,1,1)
	knob.Text=""
	knob.AutoButtonColor=false
	knob.ZIndex=3
	knob.Parent=track
	Corner(knob,99)

	local dragging=false

	local function setVisual(v)
		v=math.clamp(v,min,max)
		local a=(v-min)/(max-min)
		fill.Size=UDim2.fromScale(a,1)
		knob.Position=UDim2.fromScale(a,.5)
		input.Text=tostring(math.floor(v+.5))
	end

	local function setFromX(x)
		local a=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
		local v=math.floor(min+(max-min)*a+.5)
		setValue(v)
		setVisual(v)
	end

	local function begin(i)
		dragging=true
		setFromX(i.Position.X)
	end

	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			begin(i)
		end
	end)

	knob.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			begin(i)
		end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then
			setFromX(i.Position.X)
		end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			dragging=false
		end
	end)

	input.FocusLost:Connect(function()
		local v=tonumber(input.Text)
		if not v then
			setVisual(getValue())
			return
		end
		v=math.clamp(math.floor(v+.5),min,max)
		setValue(v)
		setVisual(v)
	end)

	setVisual(getValue())
end


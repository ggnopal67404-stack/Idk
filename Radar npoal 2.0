YesButton.Visible=false
YesButton.ZIndex=100

local function UpdateTeleportPosition()
	if not TeleportPrompt.Visible then return end
	local p=Radar.AbsolutePosition
	local s=Radar.AbsoluteSize
	local gap=8
	local y=p.Y+s.Y+gap
	TeleportPrompt.Position=UDim2.fromOffset(p.X+(s.X-210)/2,y)
	NoButton.Position=UDim2.fromOffset(p.X+s.X/2-94,y+46)
	YesButton.Position=UDim2.fromOffset(p.X+s.X/2+4,y+46)
end

local function RemoveTeleportHighlight()
	if TeleportHighlight then
		TeleportHighlight:Destroy()
		TeleportHighlight=nil
	end
end

local function ClearSelection()
	SelectedPlayer=nil
	RemoveTeleportHighlight()
	TeleportPrompt.Visible=false
	NoButton.Visible=false
	YesButton.Visible=false
end

local function ShowTeleportHighlight(p)
	RemoveTeleportHighlight()
	local char=p and p.Character
	if not char then return end

	local h=Instance.new("Highlight")
	h.Name="TeleportTargetChams"
	h.Adornee=char
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.FillColor=Color3.fromRGB(40,120,255)
	h.OutlineColor=Color3.fromRGB(100,180,255)
	h.FillTransparency=.3
	h.OutlineTransparency=0
	h.Parent=char
	TeleportHighlight=h
end

NoButton.Activated:Connect(ClearSelection)

YesButton.Activated:Connect(function()
	local p=SelectedPlayer
	if not p or not p.Parent then
		ClearSelection()
		return
	end

	local char=p.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local myChar=Player.Character

	if root and myChar then
		myChar:PivotTo(root.CFrame*CFrame.new(0,3,0))
	end

	ClearSelection()
end)

Close.Activated:Connect(function()
	Settings.Visible=false
end)

RadarButton.Activated:Connect(function()
	RadarEnabled=not RadarEnabled
	Radar.Visible=RadarEnabled
	RadarButton.Text=RadarEnabled and "RADAR • ON" or "RADAR • OFF"

	if not RadarEnabled then
		ClearSelection()
	end
end)

SettingsButton.Activated:Connect(function()
	Settings.Visible=not Settings.Visible
end)

RadarTab.Activated:Connect(function()
	RadarPanel.Visible=true
	MapPanel.Visible=false
	Panel.CanvasPosition=Vector2.zero
end)

MapTab.Activated:Connect(function()
	RadarPanel.Visible=false
	MapPanel.Visible=true
	Panel.CanvasPosition=Vector2.zero
end)

local function RemoveMarker(key)
	local marker=Markers[key]
	if marker then
		marker:Destroy()
		Markers[key]=nil
	end

	if SelectedPlayer==key then
		ClearSelection()
	end
end

local function CreateMarker(key,color,text)
	local holder=Instance.new("TextButton")
	holder.Size=UDim2.fromOffset(24,24)
	holder.AnchorPoint=Vector2.new(.5,.5)
	holder.BackgroundTransparency=1
	holder.Text=""
	holder.AutoButtonColor=false
	holder.ZIndex=30
	holder.Parent=Radar

	local dot=Instance.new("Frame")
	dot.Size=UDim2.fromOffset(8,8)
	dot.AnchorPoint=Vector2.new(.5,.5)
	dot.Position=UDim2.fromScale(.5,.5)
	dot.BackgroundColor3=color
	dot.BorderSizePixel=0
	dot.ZIndex=31
	dot.Parent=holder
	Corner(dot,99)

	local label=Instance.new("TextLabel")
	label.Name="Name"
	label.Size=UDim2.fromOffset(120,20)
	label.Position=UDim2.fromOffset(8,-10)
	label.BackgroundTransparency=1
	label.Text=text or ""
	label.TextColor3=Color3.new(1,1,1)
	label.TextStrokeTransparency=.4
	label.Font=Enum.Font.Gotham
	label.TextSize=10
	label.TextXAlignment=Enum.TextXAlignment.Left
	label.Visible=text~=nil
	label.ZIndex=32
	label.Parent=holder

	if key:IsA("Player") then
		holder.Activated:Connect(function()
			if Unloaded or not key.Parent then return end

			SelectedPlayer=key
			TeleportPrompt.Text='TP "'..key.DisplayName..'"?'
			TeleportPrompt.Visible=true
			NoButton.Visible=true
			YesButton.Visible=true
			ShowTeleportHighlight(key)
			UpdateTeleportPosition()
		end)
	end

	Markers[key]=holder
	return holder
end

local function GetPlayerColor(other)
	if TeamEnabled and Player.Team and other.Team and Player.Team==other.Team then
		return Color3.fromRGB(60,255,120)
	end
	return Color3.fromRGB(255,70,70)
end

local function UpdatePlayerESP(other)
	if other==Player then return end

	local character=other.Character

	if ESPPlayerEnabled and character then
		local h=PlayerHighlights[other]

		if not h or not h.Parent then
			h=Instance.new("Highlight")
			h.Name="RadarChams"
			h.Adornee=character
			h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
			h.FillTransparency=.35
			h.OutlineTransparency=0
			h.Parent=character
			PlayerHighlights[other]=h
		end

		h.FillColor=GetPlayerColor(other)
		h.OutlineColor=Color3.new(1,1,1)
	else
		if PlayerHighlights[other] then
			PlayerHighlights[other]:Destroy()
			PlayerHighlights[other]=nil
		end
	end
end

local function IsNPC(model)
	if not model:IsA("Model") then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	if not model:FindFirstChildOfClass("Humanoid") then return false end
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function RefreshNPCs()
	table.clear(NPCs)
	for _,obj in ipairs(Workspace:GetDescendants()) do
		if IsNPC(obj) then
			NPCs[obj]=true
		end
	end
end

local function SmoothMarker(marker,target,dt,instant)
	if instant then
		marker.Position=target
	else
		marker.Position=marker.Position:Lerp(target,1-math.exp(-14*dt))
	end
end

local function UpdateRadar(dt)
	if Unloaded or not RadarEnabled then return end

	local camera=Workspace.CurrentCamera
	local character=Player.Character
	local myRoot=character and character:FindFirstChild("HumanoidRootPart")

	if not camera or not myRoot then return end

	dt=math.clamp(dt or .016,.001,.1)

	NPCTimer+=dt
	if NPCTimer>.5 then
		NPCTimer=0
		RefreshNPCs()
	end

	local look=camera.CFrame.LookVector
	local forward=Vector3.new(look.X,0,look.Z)

	if forward.Magnitude<.01 then
		forward=Vector3.new(0,0,-1)
	end

	forward=forward.Unit
	local right=Vector3.new(-forward.Z,0,forward.X)

	local north=Vector3.new(0,0,-1)
	local angle=math.deg(math.atan2(forward.X,forward.Z)-math.atan2(north.X,north.Z))
	Direction.Rotation=-angle

	for _,other in ipairs(Players:GetPlayers()) do
		if other~=Player then
			UpdatePlayerESP(other)

			local char=other.Character
			local root=char and char:FindFirstChild("HumanoidRootPart")

			if PlayerEnabled and root then
				local offset=root.Position-myRoot.Position
				local distance=offset.Magnitude

				if distance<=RadarRange then
					local x=math.clamp(offset:Dot(right)/RadarRange,-.48,.48)
					local y=math.clamp(offset:Dot(forward)/RadarRange,-.48,.48)
					local target=UDim2.fromScale(.5+x,.5-y)

					local marker=Markers[other]
					local newMarker=false

					if not marker then
						marker=CreateMarker(other,GetPlayerColor(other),other.DisplayName)
						newMarker=true
					end

					marker.Visible=true
					SmoothMarker(marker,target,dt,newMarker)

					local dot=marker:FindFirstChildWhichIsA("Frame")
					if dot then
						dot.BackgroundColor3=GetPlayerColor(other)
					end

					local name=marker:FindFirstChild("Name")
					if name then
						name.Text=other.DisplayName
						name.Visible=NameEnabled
					end
				else
					RemoveMarker(other)
				end
			else
				RemoveMarker(other)
			end
		end
	end

	local activeNPCs={}

	if NPCEnabled then
		for npc in pairs(NPCs) do
			if npc.Parent then
				local root=npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart

				if root then
					local offset=root.Position-myRoot.Position
					local distance=offset.Magnitude

					if distance<=RadarRange then
						activeNPCs[npc]=true

						local x=math.clamp(offset:Dot(right)/RadarRange,-.48,.48)
						local y=math.clamp(offset:Dot(forward)/RadarRange,-.48,.48)
						local target=UDim2.fromScale(.5+x,.5-y)

						local marker=Markers[npc]
						local newMarker=false

						if not marker then
							marker=CreateMarker(npc,Color3.new(1,1,1),npc.Name)
							newMarker=true
						end

						marker.Visible=true
						SmoothMarker(marker,target,dt,newMarker)

						local dot=marker:FindFirstChildWhichIsA("Frame")
						if dot then
							dot.BackgroundColor3=Color3.new(1,1,1)
						end

						local name=marker:FindFirstChild("Name")
						if name then
							name.Text=npc.Name
							name.Visible=NameEnabl

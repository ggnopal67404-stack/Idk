local function Corner(o,r)
	local c=Instance.new("UICorner")
	c.CornerRadius=UDim.new(0,r)
	c.Parent=o
end

local function Stroke(o,t,th)
	local s=Instance.new("UIStroke")
	s.Color=Color3.new(1,1,1)
	s.Transparency=t or .75
	s.Thickness=th or 1
	s.Parent=o
end

local function Tween(o,p,time)
	TweenService:Create(o,TweenInfo.new(time or .15,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p):Play()
end

local function MakeButton(parent,text,size)
	local b=Instance.new("TextButton")
	b.Size=size
	b.BackgroundColor3=Color3.fromRGB(28,28,32)
	b.TextColor3=Color3.new(1,1,1)
	b.Text=text
	b.Font=Enum.Font.GothamBold
	b.TextSize=13
	b.AutoButtonColor=false
	b.Parent=parent
	Corner(b,10)
	Stroke(b,.8,1)
	b.MouseEnter:Connect(function()
		Tween(b,{BackgroundColor3=Color3.fromRGB(42,42,48)})
	end)
	b.MouseLeave:Connect(function()
		Tween(b,{BackgroundColor3=Color3.fromRGB(28,28,32)})
	end)
	return b
end

local function MakeDraggable(gui,locked,handle)
	local dragging=false
	local dragStart,startPos
	handle=handle or gui

	handle.InputBegan:Connect(function(input)
		if locked and locked() then return end
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
			dragging=true
			dragStart=input.Position
			startPos=gui.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging or locked and locked() then return end
		if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
			local d=input.Position-dragStart
			gui.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
			dragging=false
		end
	end)
end


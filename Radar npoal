local function RemoveMarker(key)
	if Markers[key] then
		Markers[key]:Destroy()
		Markers[key] = nil
	end
end

local function CreateMarker(key, color, text)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(8, 8)
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.BackgroundTransparency = 1
	holder.Parent = Radar

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(8, 8)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.BackgroundColor3 = color
	dot.Parent = holder
	Corner(dot, 99)

	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.Size = UDim2.fromOffset(120, 20)
	label.Position = UDim2.fromOffset(8, -10)
	label.BackgroundTransparency = 1
	label.Text = text or ""
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Font = Enum.Font.Gotham
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Visible = text ~= nil
	label.Parent = holder

	Markers[key] = holder
	return holder
end

local function GetPlayerColor(other)
	if TeamEnabled and other.Team == Player.Team then
		return Color3.fromRGB(60, 255, 120)
	end

	return Color3.fromRGB(255, 70, 70)
end

local function UpdatePlayerESP(other)
	if other == Player then
		return
	end

	local character = other.Character

	if ESPPlayerEnabled and character then
		local highlight = PlayerHighlights[other]

		if not highlight or not highlight.Parent then
			highlight = Instance.new("Highlight")
			highlight.Name = "RadarChams"
			highlight.Adornee = character
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = 0.35
			highlight.OutlineTransparency = 0
			highlight.Parent = character

			PlayerHighlights[other] = highlight
		end

		local color = GetPlayerColor(other)

		highlight.FillColor = color
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.FillTransparency = 0.35
		highlight.OutlineTransparency = 0
	else
		if PlayerHighlights[other] then
			PlayerHighlights[other]:Destroy()
			PlayerHighlights[other] = nil
		end
	end
end

local function IsNPC(model)
	if not model:IsA("Model") then
		return false
	end

	if Players:GetPlayerFromCharacter(model) then
		return false
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	local root = model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart

	return root ~= nil
end

local function GetNPCs()
	local list = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if IsNPC(obj) then
			table.insert(list, obj)
		end
	end

	return list
end

local function SmoothMarker(marker, target, deltaTime, instant)
	if instant then
		marker.Position = target
		return
	end

	local speed = 14
	local alpha = 1 - math.exp(-speed * deltaTime)

	marker.Position = marker.Position:Lerp(target, alpha)
end

local function UpdateRadar(deltaTime)
	if Unloaded or not RadarEnabled then
		return
	end

	local camera = Workspace.CurrentCamera
	local character = Player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")

	if not camera or not myRoot then
		return
	end

	deltaTime = math.clamp(deltaTime or 0.016, 0.001, 0.1)

	local look = camera.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z)

	if forward.Magnitude < 0.01 then
		forward = Vector3.new(0, 0, -1)
	end

	forward = forward.Unit

	local right = Vector3.new(-forward.Z, 0, forward.X)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= Player then
			UpdatePlayerESP(other)

			local char = other.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if PlayerEnabled and root then
				local offset = root.Position - myRoot.Position
				local distance = offset.Magnitude

				if distance <= RadarRange then
					local x = math.clamp(
						offset:Dot(right) / RadarRange,
						-0.48,
						0.48
					)

					local y = math.clamp(
						offset:Dot(forward) / RadarRange,
						-0.48,
						0.48
					)

					local target = UDim2.fromScale(
						0.5 + x,
						0.5 - y
					)

					local marker = Markers[other]
					local newMarker = false

					if not marker then
						marker = CreateMarker(
							other,
							GetPlayerColor(other),
							other.DisplayName
						)
						newMarker = true
					end

					marker.Visible = true
					SmoothMarker(marker, target, deltaTime, newMarker)

					local dot = marker:FindFirstChildWhichIsA("Frame")

					if dot then
						dot.BackgroundColor3 = GetPlayerColor(other)
					end

					local nameLabel = marker:FindFirstChild("Name")

					if nameLabel then
						nameLabel.Text = other.DisplayName
						nameLabel.Visible = NameEnabled
					end
				else
					RemoveMarker(other)
				end
			else
				RemoveMarker(other)
			end
		end
	end

	local activeNPCs = {}

	if NPCEnabled then
		for _, npc in ipairs(GetNPCs()) do
			activeNPCs[npc] = true

			local root = npc:FindFirstChild("HumanoidRootPart")
				or npc.PrimaryPart

			if root then
				local offset = root.Position - myRoot.Position
				local distance = offset.Magnitude

				if distance <= RadarRange then
					local x = math.clamp(
						offset:Dot(right) / RadarRange,
						-0.48,
						0.48
					)

					local y = math.clamp(
						offset:Dot(forward) / RadarRange,
						-0.48,
						0.48
					)

					local target = UDim2.fromScale(
						0.5 + x,
						0.5 - y
					)

					local marker = Markers[npc]
					local newMarker = false

					if not marker then
						marker = CreateMarker(
							npc,
							Color3.new(1, 1, 1),
							npc.Name
						)
						newMarker = true
					end

					marker.Visible = true
					SmoothMarker(marker, target, deltaTime, newMarker)

					local dot = marker:FindFirstChildWhichIsA("Frame")

					if dot then
						dot.BackgroundColor3 = Color3.new(1, 1, 1)
					end

					local nameLabel = marker:FindFirstChild("Name")

					if nameLabel then
						nameLabel.Text = npc.Name
						nameLabel.Visible = NameEnabled
					end
				else
					RemoveMarker(npc)
				end
			end
		end
	end

	for key, marker in pairs(Markers) do
		if typeof(key) == "Instance"
			and key:IsA("Model")
			and not activeNPCs[key]
			and not Players:GetPlayerFromCharacter(key) then

			RemoveMarker(key)
		end
	end

	local north = math.deg(math.atan2(-forward.X, -forward.Z))
	Direction.Rotation = -north
end


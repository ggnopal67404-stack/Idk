local function AddToggle(parent, y, label, getState, callback)
	local b = MakeButton(parent, "", UDim2.new(1, 0, 0, 42))
	b.Position = UDim2.fromOffset(0, y)

	local function update()
		b.Text = label .. " • " .. (getState() and "ON" or "OFF")
	end

	update()

	b.Activated:Connect(function()
		callback()
		update()
	end)

	return b
end


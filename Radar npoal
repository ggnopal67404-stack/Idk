local function Corner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
end

local function Stroke(obj, transparency, thickness)
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(1, 1, 1)
	s.Transparency = transparency or 0.75
	s.Thickness = thickness or 1
	s.Parent = obj
end

local function Tween(obj, properties, time)
	TweenService:Create(
		obj,
		TweenInfo.new(time or 0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		properties
	):Play()
end

local function MakeButton(parent, text, size)
	local b = Instance.new("TextButton")
	b.Size = size
	b.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.AutoButtonColor = false
	b.Parent = parent
	Corner(b, 10)
	Stroke(b, 0.8, 1)

	b.MouseEnter:Connect(function()
		Tween(b, {BackgroundColor3 = Color3.fromRGB(42, 42, 48)})
	end)

	b.MouseLeave:Connect(function()
		Tween(b, {BackgroundColor3 = Color3.fromRGB(28, 28, 32)})
	end)

	return b
end

local function MakeDraggable(gui, locked)
	local dragging = false
	local dragStart
	local startPos

	gui.InputBegan:Connect(function(input)
		if locked and locked() then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = gui.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			gui.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

